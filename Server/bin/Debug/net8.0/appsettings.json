{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TcpSettings": {
    "MasterPort": 9000,
    "HeartbeatIntervalSeconds": 30,
    "ConnectionTimeoutSeconds": 10,
    "MaxWorkers": 100
  },
  "SolverSettings": {
    "DefaultMaxIterations": 10000,
    "DefaultTolerance": 0.000001,
    "MaxMatrixSize": 50000,
    "EnableLogging": true,
    "AutoStartWorkers": true,
    "WorkerCount": 4
  }
}
{
  "openapi": "3.0.1",
  "info": {
    "title": "Server",
    "version": "1.0"
  },
  "paths": {
    "/api/Solver/upload/matrix": {
      "post": {
        "tags": [
          "Solver"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "file": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Solver/upload/vector": {
      "post": {
        "tags": [
          "Solver"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "file": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Solver/generate": {
      "post": {
        "tags": [
          "Solver"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateOptionsNew"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateOptionsNew"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateOptionsNew"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Solver/start": {
      "post": {
        "tags": [
          "Solver"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolverOptions"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SolverOptions"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SolverOptions"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Solver/status": {
      "get": {
        "tags": [
          "Solver"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Solver/result": {
      "get": {
        "tags": [
          "Solver"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Solver/clear": {
      "post": {
        "tags": [
          "Solver"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GenerateOptionsNew": {
        "type": "object",
        "properties": {
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "sparsity": {
            "type": "number",
            "format": "double"
          },
          "diagonalDominance": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "SolverOptions": {
        "type": "object",
        "properties": {
          "useGauss": {
            "type": "boolean"
          },
          "useConjugateGradient": {
            "type": "boolean"
          },
          "maxIterations": {
            "type": "integer",
            "format": "int32"
          },
          "tolerance": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
  }
}